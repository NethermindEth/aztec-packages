# Disk-based logging system with synchronous SSH transfer to bastion.
# Logs are written to /logs-disk on bastion via SCP.

# Transfer log to bastion via SSH (accepts gzipped data on stdin)
# Usage: echo "$gzipped_data" | disk_log_transfer <key>
function disk_log_transfer {
  local key="$1"

  # Transfer via SSH pipe directly to file on bastion
  ssh -F "${ci3}/aws/build_instance_ssh_config" \
      -o ControlMaster=auto \
      -o ControlPath=/tmp/ssh_mux_%h_%p_%r \
      -o ConnectTimeout=5 \
      ci-bastion.aztecprotocol.com \
      "cat > /logs-disk/${key}.log.gz" &>/dev/null
}

# Export functions
export -f disk_log_transfer
