#!/usr/bin/env bash
set -euo pipefail

>&2 echo "The 'aztec-nargo' command has been deprecated and the corresponding functionality has been moved to the 'aztec' command."
>&2 echo "All aztec-nargo functionality has been moved to the 'aztec' command:"
>&2 echo "  - For init: aztec init (just like nargo init but defaults to --contract)"
>&2 echo "  - For test: aztec test (spins up TXE and runs tests with nargo test)"
>&2 echo "  - For compile: aztec compile (this command now transpiles the contract and generates verification keys as well)"
>&2 echo ""
exit 1
